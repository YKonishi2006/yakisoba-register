rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null && request.auth.token.email in ['staff@example.com'];
    }
    match /stores/{store} {
      allow read, write: if isStaff();
      match /tx/{txId} {
        allow read, write: if isStaff();
      }
    }
  }
}
